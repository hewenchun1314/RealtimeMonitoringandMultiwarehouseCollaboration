    "backend_bundle": {
      "name": "srv-workspace",
      "services": {
        "smart-geo": {
          "repository": "smart-geo",
          "branch": "AI-development",
          "build_command": "mvn -B -pl smart-geo/smart-geo-server -am -DskipTests package",
          "test_command": "mvn -B -pl smart-geo/smart-geo-server -am test",
          "start_command": "java -jar (Get-Item 'smart-geo-server/target/smart-geo-server-*.jar').FullName --server.address=127.0.0.1 --server.port=18081",
          "acceptance_command": "Invoke-RestMethod -TimeoutSec 10 'http://127.0.0.1:18081/tet/smart-geo/actuator/health'"
        },
        "model-manage-srv": {
          "repository": "model-manage-srv",
          "branch": "AI-development",
          "build_command": "mvn -B -pl model-manage-srv/app -am -DskipTests package",
          "test_command": "mvn -B -pl model-manage-srv/app -am test",
          "start_command": "java -jar (Get-Item 'app/target/app-*.jar').FullName --server.address=127.0.0.1 --server.port=18082",
          "acceptance_command": "Invoke-RestMethod -TimeoutSec 10 'http://127.0.0.1:18082/tet/model-manage/api/v3/api-docs'"
        },
        "task-manage-grpc": {
          "repository": "task-manage-grpc",
          "branch": "AI-development",
          "build_command": "mvn -B -pl task-manage-server -am -DskipTests package",
          "test_command": "mvn -B -pl task-manage-server -am test",
          "start_command": "java -jar (Get-Item 'task-manage-server/target/task-manage-server-*.jar').FullName --server.address=127.0.0.1 --server.port=18083",
          "acceptance_command": "Invoke-RestMethod -TimeoutSec 10 'http://127.0.0.1:18083/actuator/health'"
        },
        "tet-task-manager": {
          "repository": "tet-task-manager",
          "branch": "AI-development",
          "build_command": "dotnet build Tet.TaskManager.sln",
          "test_command": "dotnet test Tet.TaskManager.Tests/Tet.TaskManager.Tests.csproj",
          "start_command": "dotnet run --no-build --project Tet.TaskManager.WebApi/Tet.TaskManager.WebApi.csproj --launch-profile http",
          "acceptance_command": "Invoke-RestMethod -TimeoutSec 10 'http://127.0.0.1/swagger/v1/swagger.json'"
        },
        "model-python": {
          "repository": "model-python",
          "branch": "AI-development",
          "build_command": "uv run --frozen python -m compileall -q app",
          "test_command": "uv run --frozen pytest -q",
          "start_command": "uv run --frozen uvicorn app.main:app --host 127.0.0.1 --port 5111",
          "acceptance_command": "Invoke-RestMethod -TimeoutSec 10 'http://127.0.0.1:5111/version'"
        }
      }
    },
    "step_timeout_minutes": {
      "material_check": 10,
