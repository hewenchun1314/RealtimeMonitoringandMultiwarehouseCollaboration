{
  "zentao": {
    "base_url": "https://zentao.example.invalid",
    "project_name": "填写禅道项目全名",
    "assigned_to_accounts": [
      "填写接单账号"
    ],
    "accepted_statuses": {
      "story": [
        "reviewing",
        "active"
      ],
      "bug": []
    },
    "credential_ref": "windows-dpapi:zentao"
  },
  "workspaces": {
    "requirement": "../requirements-repo",
    "frontend": "../frontend-repo"
  },
  "monitor": {
    "enabled": false,
    "interval_minutes": 3
  },
  "runtime": {
    "require_unattended_approval": true
  },
  "development": {
    "allowed_requirement_types": [
      "frontend_only"
    ],
    "max_concurrent_items": 1,
    "max_retries_per_step": 3,
    "frontend_bundle": {
      "name": "frontend",
      "applications": {
        "web": {
          "repository": ".",
          "branch": "main"
        }
      }
    },
    "step_timeout_minutes": {
      "material_check": 10,
      "design": 45,
      "plan": 45,
      "branch_check": 15,
      "coding": 120,
      "unit_test": 45,
      "code_review": 45,
      "e2e": 90,
      "integration": 45
    }
  },
  "e2e": {
    "workspace": "frontend",
    "start_command": "npm run dev",
    "ready_url": "http://localhost:5173",
    "platform_entry_path": "/",
    "login": {
      "path": "/login",
      "username": "填写测试账号",
      "credential_ref": "windows-dpapi:e2e"
    },
    "default_work_area": null
  }
}
